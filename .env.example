# ============================================================================
# WeChatPadPro → Hermes 平台插件配置范例
#
# 复制到 <HERMES_HOME>/.env（单 profile）或 <HERMES_HOME>/profiles/<name>/.env
# （多 profile），按需填写。文件权限建议 0600。
#
# ⚠️ 不要把填好的文件提交到 Git。仓库里的账号文件只允许 *.example.json。
# ============================================================================

# ---------------------------------------------------------------- 必填：连接
# 你的 WeChatPadPro 兼容服务地址（只写到根路径，不带 /ws/sync）
WECHATPRO_API_BASE=https://your-vendor.example

# 留空时按 API base 推导：https://host → wss://host/ws/sync
# WECHATPRO_WS_URL=wss://your-vendor.example/ws/sync

# vendor 分配的客户端凭据。一个客户端密钥同一时间只能被一个客户端使用。
WECHATPRO_AUTHCODE=replace-with-your-authcode
WECHATPRO_TOKEN_KEY=replace-with-your-token-key

# ------------------------------------------------------------ 触发与白名单
# 允许私聊机器人的用户，逗号分隔；留空表示只按账号 JSON 的 allowFrom 判断。
# WECHATPRO_ALLOWED_USERS=wxid_friend_1,wxid_friend_2
# WECHATPRO_ALLOW_ALL_USERS=0

# cron / 通知的默认投递目标，格式 accountId:peerId
# WECHATPRO_HOME_CHANNEL=default:wxid_friend_1

# -------------------------------------------------------------- webhook
# vendor 回调的公网基址。没有默认值，必须显式配置；配错会把入站流量指到别处。
# WECHATPRO_WEBHOOK_PUBLIC_URL=https://bot.example.com
# WECHATPRO_WEBHOOK_HOST=127.0.0.1
# WECHATPRO_WEBHOOK_SECRET=replace-with-a-random-secret

# ---------------------------------------------------------------- MariaDB（可选）
# 不配也能收发消息；历史检索、心流落库、审计等能力会降级。
# host 只允许本机；确需远程时显式设置 WECHATPRO_DB_ALLOW_REMOTE=1。
# WECHATPRO_DB_HOST=127.0.0.1
# WECHATPRO_DB_PORT=3306
# WECHATPRO_DB_USER=wechatpro
# WECHATPRO_DB_PASSWORD=replace-with-db-password
# WECHATPRO_DB_NAME=wechatpro

# ---------------------------------------------------------------- LLM（可选）
# 心流 / 好感度 / 黑话 / 风格学习使用；也可在账号 JSON 里单独配模型。
# WECHATPRO_LLM_API_KEY=replace-with-llm-key

# ---------------------------------------------------------------- 语音（可选）
# 厂商已带转写时不需要；缺失只会在第一条语音上打一次 WARNING。
# WECHATPRO_STT_API_KEY=replace-with-stt-key
# WPP_STT_BACKEND=siliconflow
# WPP_SILK_DECODER_PATH=~/silk_decoder/silk/decoder
# WPP_SILK_ENCODER_PATH=~/silk_decoder/silk/encoder

# ---------------------------------------------------------------- 安全护栏（可选）
# 生产 bot 保护：列出的 wxid / 凭据指纹禁止在测试或临时实例里连接。
# WECHATPRO_PROTECTED_WXIDS=
# WECHATPRO_PROTECTED_FINGERPRINTS=
# WECHATPRO_ALLOW_PRODUCTION_WXID=0

# 出站白名单（收口在 core/api_client）；留空表示不限制。
# WECHATPRO_SEND_ALLOWLIST=
