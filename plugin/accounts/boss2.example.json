{
  "_comment": "第二账号范例（多账号隔离）。复制为 accounts/<your_id>.json。每个账号必须使用独立 authcode、独立 selfWxid、独立 webhookPort，并绑定自己的 agent profile；agent 禁止写 'main'。强烈建议只写 authcodeEnv/tokenKeyEnv，明文放对应 profile 的 .env。",
  "enabled": false,

  "apiBaseUrl": "https://your-vendor.example",
  "wsUrl": "wss://your-vendor.example/ws/sync",

  "authcode": "",
  "authcodeEnv": "WECHATPRO_AUTHCODE_SECOND",
  "tokenKey": "",
  "tokenKeyEnv": "WECHATPRO_TOKEN_KEY_SECOND",

  "webhookHost": "127.0.0.1",
  "webhookPort": 4399,
  "webhookPath": "/wechatpadpro/second/webhook",
  "webhookPathToken": "replace-with-a-random-token",
  "webhookPublicUrl": "",
  "webhookPublicUrlEnv": "WECHATPRO_WEBHOOK_PUBLIC_URL_SECOND",
  "autoSetWebhook": true,
  "setWebhookRetries": 3,

  "dmPolicy": "allowlist",
  "allowFrom": ["wxid_owner"],
  "blacklistUsers": [],
  "groupPolicy": "disabled",
  "groupAllowFrom": [],
  "adminUsers": ["wxid_owner"],
  "blacklistGroups": [],

  "selfWxid": "wxid_replace_me_second",
  "nickname": "微信助手-副号",

  "agent": "wpp-wechat-second",
  "debounceMs": 1500,

  "mcpEnabled": false,
  "webhookBusinessPath": "/wechatpadpro/second/webhook/business",
  "webhookSecretEnv": "WECHATPRO_WEBHOOK_SECRET_SECOND",

  "chatroomDebug": false,
  "dmPairingEnabled": false,
  "groupContextEnabled": false,
  "friendCirclePublishEnabled": false,
  "friendCirclePublishAllowFrom": [],

  "heartflow": {
    "enabled": false,
    "model": "your-model-name",
    "whitelistGroups": [],
    "replyThreshold": 0.6,
    "minReplyIntervalSec": 0,
    "minJudgeIntervalSec": 60,
    "maxRetries": 1,
    "timeoutMs": 5000,
    "independentTrigger": false,
    "businessContext": "",
    "groupBusinessContexts": {},
    "profile": {"enabled": true, "applyQuietHours": false}
  },

  "affection": {
    "enabled": false,
    "model": "your-model-name",
    "timeoutMs": 5000,
    "maxRetries": 1,
    "replyThreshold": 0.6,
    "minReplyIntervalSec": 0,
    "minJudgeIntervalSec": 60
  },

  "jargon": {
    "enabled": false,
    "model": "your-model-name",
    "timeoutMs": 5000,
    "mineIntervalSec": 60,
    "minMessages": 10,
    "maxCandidatesPerGroup": 50
  },

  "style": {
    "enabled": false,
    "model": "your-model-name",
    "lookbackDays": 14,
    "minMsgs": 80,
    "minSenders": 3,
    "sampleMsgs": 120,
    "refreshHours": 72,
    "maxPerRun": 2,
    "maxTokens": 700,
    "timeoutMs": 20000,
    "maxPromptChars": 300,
    "minConfidence": 0.62,
    "whitelistGroups": []
  },

  "tts": {
    "enabled": false,
    "provider": "tokenplan",
    "voice": "",
    "maxChars": 300,
    "autoVoice": 0,
    "autoVoiceMinChars": 4,
    "autoVoiceMaxChars": 120,
    "whitelistGroups": [],
    "whitelistUsers": [],
    "fallbackMmx": false
  },

  "debounceMerge": {"enabled": false, "maxChars": 2000},

  "proactive": {
    "enabled": false,
    "allowFrom": [],
    "maxPerDay": 1,
    "minIdleHours": 20,
    "quietHours": [23, 8],
    "model": "",
    "maxChars": 120,
    "historyLimit": 20,
    "timeoutMs": 8000
  },

  "spectre": {"quoteHint": false},

  "llmIntentEnabled": true,
  "llmIntentModel": "your-model-name",
  "llmIntentTimeoutMs": 5000,
  "groupContextWindow": 10,
  "embeddingApiKeyEnv": "",
  "embeddingModel": "",
  "embedIntentTopN": 5,
  "embedIntentThreshold": 0.3
}
