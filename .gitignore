# 缓存
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# 日志 / 临时
*.log
*.tmp
*.orig
*.rej

# ⚠️ 凭证：账号文件含 authcode，**禁止提交**
#    只放行 *.example.json（schema 范例，里面必须是占位值）
plugin/accounts/*.json
!plugin/accounts/*.example.json

# 本地 env（可能含 DB 口令 / LLM key）
.env
.env.*
!.env.example

# 覆盖率产物
.coverage
.coverage.*
htmlcov/

# 部署产物与备份（不属于源码）
deploy.sh
sync.sh
*.tar.gz
*.zip
*.bak-*

# 内部运维材料（本机保留，不进入公开树）
tools/
docs/internal/

# 技能工坊暂存区（临时产物）
skills-workshop-staging/

# 本机测试护栏：生产 bot wxid（公开仓不携带）
conftest_local.py
